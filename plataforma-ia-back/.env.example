# ── IA — Claude API (vía capa OpenAI-compat de Anthropic) ────────────────────
# Endpoint HTTP externo. La key sale de https://console.anthropic.com (Settings
# → API Keys). Empieza con `sk-ant-`. Requiere crédito de API recargado.
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Modelo: claude-haiku-4-5 (rápido/barato) | claude-sonnet-4-6 (recomendado) |
# claude-opus-4-7 (mejor razonamiento, más caro).
CHAT_MODEL=claude-sonnet-4-6
# Temperatura para specs estructurados (tool calls JSON). 0.2-0.3 recomendado.
CHAT_TEMPERATURE_STRUCTURED=0.2

# ── Base de datos — MongoDB (Atlas M0 en el demo) ─────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=plataformaia

# ── Storage de archivos — Google Cloud Storage ───────────────────────────────
# En Cloud Run usa Application Default Credentials (la service account del
# servicio). Si se deja vacío, StorageService cae a disco local.
# Crear bucket: gcloud storage buckets create gs://<name> --location=us-central1
GCS_BUCKET_NAME=plataforma-ia-files
# Solo para desarrollo local: ruta a un JSON de service account de GCP.
# GOOGLE_APPLICATION_CREDENTIALS=

# ── Auth — modo demo ──────────────────────────────────────────────────────────
# true → omite MSAL/Entra ID e inyecta un usuario Admin simulado.
DEMO_AUTH=true

# ── Auth real (solo si DEMO_AUTH=false) ───────────────────────────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
ALLOWED_EMAIL_DOMAINS=tu-dominio.com

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Cloud Run inyecta $PORT automáticamente; API_PORT solo aplica en local.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development

# ── Integraciones OAuth (opcional — no funcionales en el demo) ────────────────
# Sin estos valores, los endpoints de Outlook/Jira degradan a "no configurado".
# AZURE_CLIENT_SECRET=
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
# INTEGRATION_ENCRYPTION_KEY=

# ── Dashboard: métricas manuales (opcional) ──────────────────────────────────
# Si se dejan vacías, el dashboard muestra "Sin dato" en vez de valores inventados.
# DASHBOARD_ENGAGEMENT_SCORE=94        # % satisfacción (0-100)
# DASHBOARD_ROI_USD=8200000            # retorno anual estimado en USD
