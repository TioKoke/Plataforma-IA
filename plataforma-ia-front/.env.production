# VITE_API_URL = URL del backend en Cloud Run.
# Se puede definir aquí o inyectar en Vercel (Project Settings → Environment Variables).
# Ejemplo: VITE_API_URL=https://plataforma-ia-api-xxxxx.run.app
VITE_API_URL=

# Modo demo: omite MSAL e inyecta un usuario Admin simulado.
VITE_DEMO_AUTH=true

# Auth real (solo si VITE_DEMO_AUTH=false)
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ALLOWED_EMAIL_DOMAINS=tu-dominio.com
